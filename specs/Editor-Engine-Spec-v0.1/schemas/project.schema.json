{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://fnfuniversal.dev/schemas/project.schema.json",
  "title":"FNF Universal Project","type":"object",
  "required":["format","formatVersion","id","name","songs"],
  "properties":{
    "format":{"const":"fnf-universal-project"},
    "formatVersion":{"type":"integer","minimum":1},
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{1,63}$"},
    "name":{"type":"string","minLength":1,"maxLength":100},
    "author":{"type":"string","maxLength":100},
    "description":{"type":"string","maxLength":2000},
    "targetEngines":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "assets":{"type":"array","items":{"type":"string"}},
    "songs":{"type":"array","minItems":1,"items":{"type":"object","required":["id","chart"],"properties":{
      "id":{"type":"string"},"chart":{"type":"string"},
      "noteVisualProfile":{"type":"string"},"enemyProfile":{"type":"string"},
      "settingsProfile":{"type":"string"},"scripts":{"type":"array","items":{"type":"string"}}
    }}},
    "scripts":{"type":"array","items":{"type":"object","required":["id","path","language"],"properties":{
      "id":{"type":"string"},"path":{"type":"string"},"language":{"type":"string"},
      "capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true}
    }}}
  },
  "additionalProperties":false
}